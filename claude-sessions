#!/usr/bin/python3
"""Pick a Claude Code chat session and resume it.

Type to search project names and chat titles. ↑↓ select, Enter resume,
← → change page, Esc clears the search (or quits when it is empty).

"+ New session" (or Tab) opens a folder browser: ↑↓ select, → open a folder,
← go up, Enter start a new session in the highlighted folder. Type to filter
folders, or type a name and pick "+ create folder" to make a new one.

Move a chat to another Mac: select it and press Ctrl-S. It is saved as
~/Downloads/<project>-<id>.claude-session; AirDrop (or copy) that file over.
On the other Mac it shows up at the top of `cs` (or run `cs import <file>`);
Enter imports it into that project's folder and resumes it.

Setup (once): add this to ~/.zshrc
  eval "$(claude-sessions init zsh)"

Usage:
  cs            all chats, newest first
  cs bird       start with "bird" already in the search box
  cs --new      open straight on the folder browser for a new session
  cs import F   import a chat saved with Ctrl-S on another Mac, and resume it
  cs -n 20      show 20 per page (default 25, fewer on short windows)
"""
import glob, io, json, math, os, re, select, shutil, signal, subprocess, sys
import tarfile, termios, threading, time, tty, unicodedata

VERSION = "1.2.0"
SKIP_PREFIXES = ("<command-", "<local-command", "Caveat:", "<system-reminder")
PAGE_SIZE = 25
PANEL_LINES = 14  # lines the panel uses besides the chat rows
MAX_WIDTH = 110  # widest the panel gets on a big terminal
MAX_TITLE = 300  # characters of a title kept in the cache (and searched)
CACHE = os.path.expanduser("~/.cache/claude-sessions.json")
# Claude Code's own folder (it honours CLAUDE_CONFIG_DIR too).
CLAUDE = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
DOWNLOADS = os.path.expanduser("~/Downloads")
BUNDLE_EXT = ".claude-session"  # a chat packed for another Mac (a .tar.gz)
CACHE_VERSION = 1
TTY = sys.stdout.isatty()


def color(code):
    return f"\033[{code}m" if TTY else ""


RESET = color("0")
BRIGHT = color("1;38;5;46")    # neon green
GREEN = color("38;5;34")
PALE = color("38;5;151")       # chat titles
DARK = color("38;5;28")        # borders and rules
GRAY = color("38;5;245")
SELECTED = color("1;38;5;46;48;5;22")  # neon green on a dark green bar
HIT = color("1;4;38;5;46")             # search match: neon, underlined
HIT_SELECTED = color("1;38;5;16;48;5;46")  # search match on the selected row
WARN = color("38;5;214")
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
BANNER = "▓▒░  C L A U D E   S E S S I O N S  ░▒▓"
# The picker draws on the terminal's alternate screen (like less or vim), with
# the cursor hidden, so the list is gone once you pick. Each frame starts at
# the top-left and clears whatever it didn't overwrite, so redraws don't flicker.
ALT_ON, ALT_OFF = "\033[?1049h\033[?25l", "\033[?25h\033[?1049l"
HOME, EOL, EOS = "\033[H", "\033[K", "\033[J"
if not TTY:
    ALT_ON = ALT_OFF = HOME = EOL = EOS = ""


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for b in content:
            if isinstance(b, dict) and b.get("type") == "text":
                return b.get("text", "")
    return ""


def short(text):
    return " ".join(text.split())[:MAX_TITLE]


def scan(path, size, entry):
    """Bring a session's cache entry up to date. Session logs only grow, so
    only the lines added since the last run are read."""
    if not entry or size < entry["offset"]:
        entry = {"offset": 0, "custom": None, "summary": None,
                 "first": None, "cwd": None}
    if size == entry["offset"]:
        return entry
    offset = entry["offset"]
    with open(path, "rb") as f:
        f.seek(offset)
        for line in f:
            if not line.endswith(b"\n"):
                break  # still being written; it is read next time
            offset += len(line)
            if not (b'"customTitle"' in line or b'"summary"' in line
                    or (entry["first"] is None and b'"user"' in line)
                    or entry["cwd"] is None):
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if not isinstance(o, dict):
                continue
            entry["cwd"] = entry["cwd"] or o.get("cwd")
            if o.get("customTitle"):
                entry["custom"] = short(o["customTitle"])
            elif o.get("type") == "summary" and o.get("summary"):
                entry["summary"] = entry["summary"] or short(o["summary"])
            elif (entry["first"] is None and o.get("type") == "user"
                  and not o.get("isMeta")):
                t = text_of((o.get("message") or {}).get("content")).strip()
                if t and not t.startswith(SKIP_PREFIXES):
                    entry["first"] = short(t)
    entry["offset"] = offset
    return entry


def load_sessions(progress):
    """All titled chats, newest first. Updates progress["done"/"total"]."""
    try:
        with open(CACHE) as f:
            cache = json.load(f)
        known = cache["files"] if cache.get("version") == CACHE_VERSION else {}
    except (OSError, ValueError, KeyError, AttributeError):
        known = {}
    paths = glob.glob(os.path.join(CLAUDE, "projects", "*", "*.jsonl"))
    progress["total"] = len(paths)
    fresh, rows = {}, []
    for p in paths:
        try:
            st = os.stat(p)
            entry = fresh[p] = scan(p, st.st_size, known.get(p))
        except OSError:
            continue
        finally:
            progress["done"] += 1
        title = entry["custom"] or entry["summary"] or entry["first"]
        if title:
            rows.append({"id": os.path.splitext(os.path.basename(p))[0],
                         "title": title, "cwd": entry["cwd"] or "",
                         "mtime": st.st_mtime, "size": st.st_size, "path": p})
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + ".tmp", "w") as f:
            json.dump({"version": CACHE_VERSION, "files": fresh}, f)
        os.replace(CACHE + ".tmp", CACHE)
    except OSError:
        pass  # no cache this time; the next run reads everything again
    return rows


class Counting:
    """File wrapper that adds the bytes read to progress["done"]."""

    def __init__(self, f, progress):
        self.f, self.progress = f, progress

    def read(self, n=-1):
        data = self.f.read(n)
        self.progress["done"] += len(data)
        return data


def project_dir(cwd):
    """Claude Code keeps a project's chats in a folder named after its path."""
    return os.path.join(CLAUDE, "projects", re.sub(r"[^a-zA-Z0-9]", "-", cwd))


def session_files(r):
    """(path, name in the bundle, size) of every file belonging to a chat: its
    log, its subagent/tool-output folder, file checkpoints and uploads."""
    sid = r["id"]
    out = [(r["path"], f"session/{sid}.jsonl")]
    for root, arc in ((os.path.join(os.path.dirname(r["path"]), sid), f"session/{sid}"),
                      (os.path.join(CLAUDE, "file-history", sid), f"file-history/{sid}"),
                      (os.path.join(CLAUDE, "uploads", sid), f"uploads/{sid}")):
        for dirpath, _, names in os.walk(root):
            for n in sorted(names):
                path = os.path.join(dirpath, n)
                if os.path.isfile(path) and not os.path.islink(path):
                    out.append((path, arc + path[len(root):]))
    return [(p, a, os.path.getsize(p)) for p, a in out]


def export_session(r, progress):
    """Pack a chat into ~/Downloads/<project>-<id>.claude-session; return its path."""
    files = session_files(r)
    progress["total"] = sum(size for _, _, size in files) or 1
    manifest = {"format": "claude-session", "version": 1, "id": r["id"],
                "title": r["title"], "cwd": r["cwd"], "home": os.path.expanduser("~"),
                "size": r["size"], "bytes": progress["total"], "exported": time.time()}
    name = re.sub(r"[^A-Za-z0-9._-]", "-", project(r)) + f"-{r['id'][:8]}{BUNDLE_EXT}"
    dest = os.path.join(DOWNLOADS, name)
    os.makedirs(DOWNLOADS, exist_ok=True)
    tmp = dest + ".part"
    try:
        with tarfile.open(tmp, "w:gz", compresslevel=6) as tar:
            data = json.dumps(manifest, ensure_ascii=False).encode()
            info = tarfile.TarInfo("manifest.json")  # first, so it reads fast
            info.size, info.mtime = len(data), time.time()
            tar.addfile(info, io.BytesIO(data))
            for path, arc, size in files:
                info = tar.gettarinfo(path, arc)
                info.uid = info.gid = 0
                info.uname = info.gname = ""
                with open(path, "rb") as f:
                    tar.addfile(info, Counting(f, progress))
        os.replace(tmp, dest)
    except BaseException:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise
    return dest


def read_bundle(path):
    """The manifest of a .claude-session file, or None if it isn't one."""
    try:
        with tarfile.open(path, "r:gz") as tar:
            first = tar.next()
            if first is None or first.name != "manifest.json":
                return None
            m = json.load(tar.extractfile(first))
    except (OSError, EOFError, tarfile.TarError, ValueError):
        return None
    if (not isinstance(m, dict) or m.get("format") != "claude-session"
            or not re.fullmatch(r"[A-Za-z0-9-]+", str(m.get("id", "")))):
        return None
    m["file"] = path
    return m


def incoming_bundles():
    """Chats saved on another Mac and waiting in ~/Downloads, newest first,
    leaving out ones already imported (unless the file has more of the chat)."""
    out = []
    for path in sorted(glob.glob(os.path.join(DOWNLOADS, "*" + BUNDLE_EXT)),
                       key=os.path.getmtime, reverse=True):
        m = read_bundle(path)
        if not m:
            continue
        local = glob.glob(os.path.join(CLAUDE, "projects", "*", m["id"] + ".jsonl"))
        if local and max(os.path.getsize(p) for p in local) >= m.get("size", 0):
            continue
        out.append({"kind": "incoming", "bundle": m, "id": m["id"], "title": m.get("title", "?"),
                    "cwd": m.get("cwd", ""), "mtime": os.path.getmtime(path), "style": WARN})
    return out


def import_target(m):
    """The chat's project folder on this Mac: the same path, or the same path
    under this Mac's home folder. None when neither exists (then we ask)."""
    src, src_home = m.get("cwd") or "", m.get("home") or ""
    if src and os.path.isdir(src):
        return src
    if src_home and (src == src_home or src.startswith(src_home + "/")):
        mapped = os.path.expanduser("~") + src[len(src_home):]
        if os.path.isdir(mapped):
            return mapped
    return None


def moved_line(line, old, new):
    """A log line with its working folder moved from `old` to `new`."""
    if not old or b'"cwd"' not in line:
        return line
    try:
        o = json.loads(line)
    except ValueError:
        return line
    c = o.get("cwd") if isinstance(o, dict) else None
    if not isinstance(c, str) or not (c == old or c.startswith(old + "/")):
        return line
    o["cwd"] = new + c[len(old):]
    return (json.dumps(o, ensure_ascii=False, separators=(",", ":")) + "\n").encode()


def import_bundle(m, target, progress):
    """Unpack a .claude-session into Claude Code's folders as a chat of the
    project at `target`; return it as a row ready to resume."""
    sid, old = m["id"], m.get("cwd") or ""
    roots = {"session": project_dir(target),
             "file-history": os.path.join(CLAUDE, "file-history"),
             "uploads": os.path.join(CLAUDE, "uploads")}
    log = os.path.join(roots["session"], sid + ".jsonl")
    progress["total"] = m.get("bytes") or 1
    with tarfile.open(m["file"], "r|gz") as tar:
        for t in tar:
            top, _, rest = t.name.partition("/")
            rest = os.path.normpath(rest)
            # Only files inside this chat's own folders; nothing else gets written.
            if (not t.isfile() or top not in roots or rest.startswith(("/", ".."))
                    or not (rest == sid + ".jsonl" or rest.startswith(sid + "/"))
                    or (top != "session" and rest == sid + ".jsonl")):
                continue
            dest = os.path.join(roots[top], rest)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            src = tar.extractfile(t)
            if dest == log and os.path.exists(log):  # keep what this Mac had
                os.replace(log, f"{log}.before-import-{int(time.time())}")
            with open(dest + ".importing", "wb") as f:
                if dest == log and target != old:
                    for line in src:
                        progress["done"] += len(line)
                        f.write(moved_line(line, old, target))
                else:
                    shutil.copyfileobj(Counting(src, progress), f, 1 << 20)
            os.replace(dest + ".importing", dest)
    if not os.path.exists(log):
        raise ValueError("no chat log inside the file")
    return {"id": sid, "cwd": target, "title": m.get("title", "?"),
            "size": os.path.getsize(log), "mtime": time.time(), "path": log}


def when(ts):
    d, today = time.localtime(ts), time.localtime()
    days = round((time.mktime(today[:3] + (0, 0, 0) + today[6:])
                  - time.mktime(d[:3] + (0, 0, 0) + d[6:])) / 86400)
    if days == 0:
        return "Today " + time.strftime("%H:%M", d)
    if days == 1:
        return "Yesterday " + time.strftime("%H:%M", d)
    return time.strftime("%d %b %Y", d)


def project(r):
    return os.path.basename(r["cwd"].rstrip("/")) or "?"


def cells(text):
    """Terminal columns `text` takes: Thai vowel marks take 0, CJK and emoji 2."""
    n = 0
    for ch in text:
        if unicodedata.combining(ch) or unicodedata.category(ch) in ("Mn", "Me", "Cf"):
            continue
        n += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return n


def fit(text, width, keep_end=False):
    """Cut `text` to `width` columns, marking a cut with …, and pad it out.
    keep_end keeps the end of the text instead of the start (for paths)."""
    if width <= 0:
        return ""
    used = cells(text)
    if used > width:
        kept, used = [], 0
        for ch in (reversed(text) if keep_end else text):
            if used + cells(ch) > width - 1:
                break
            kept.append(ch)
            used += cells(ch)
        text = "…" + "".join(reversed(kept)) if keep_end else "".join(kept) + "…"
        used += 1
    return text + " " * (width - used)


def projects_of(rows):
    """One entry per project folder that still exists, most recently used first."""
    by_dir = {}
    for r in rows:  # newest first
        if r["cwd"]:
            p = by_dir.setdefault(r["cwd"], {"cwd": r["cwd"], "mtime": r["mtime"],
                                             "count": 0})
            p["count"] += 1
    return [p for p in by_dir.values() if os.path.isdir(p["cwd"])]


def haystack(r):
    """What the search box looks through for a chat: project name and title."""
    return (project(r) + " " + r["title"]).lower()


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


# Pinned first row of the sessions list.
NEW_ROW = {"kind": "newsession", "cwd": "", "title": "+ New session",
           "style": BRIGHT}


def explorer_items(location, query, recent, start):
    """Rows of the new-session folder browser. location None is the start
    page: the folder `cs` was run from, then recent session folders."""
    words = query.lower().split()

    def wanted(text):
        return all(w in text.lower() for w in words)

    if location is None:
        items = [{"kind": "here", "cwd": start, "style": BRIGHT,
                  "label": f"✓ current folder  {tilde(start)}"}]
        items += [{"kind": "dir", "cwd": p["cwd"], "count": p["count"],
                   "mtime": p["mtime"], "label": f"▸ {project(p)}  {tilde(p['cwd'])}"}
                  for p in recent if wanted(project(p) + " " + p["cwd"])]
        return items
    items = [{"kind": "here", "cwd": location, "label": "✓ start here", "style": BRIGHT}]
    name = query.strip()
    target = os.path.join(location, os.path.expanduser(name)) if name else location
    items.append({"kind": "mkdir", "cwd": target, "style": GREEN, "label":
                  "+ new folder (type its name)" if not name
                  else f'↳ open "{name}"' if os.path.isdir(target)
                  else f'+ create folder "{name}"'})
    if location != "/":
        items.append({"kind": "up", "cwd": os.path.dirname(location.rstrip("/")) or "/",
                      "label": "↰ ..", "style": GRAY})
    try:
        with os.scandir(location) as entries:
            names = sorted((e.name for e in entries if e.is_dir()
                            and (not e.name.startswith(".") or query.startswith("."))),
                           key=str.lower)
    except OSError:
        items.append({"kind": "none", "cwd": location, "style": WARN,
                      "label": "can't read this folder"})
        return items
    known = {p["cwd"]: p for p in recent}
    for n in names:
        if wanted(n):
            path = os.path.join(location, n)
            p = known.get(path, {})
            items.append({"kind": "dir", "cwd": path, "label": f"▸ {n}/",
                          "count": p.get("count", 0), "mtime": p.get("mtime")})
    return items


def paint(text, style, hit, words):
    """Split `text` into (text, style) parts with the search words highlighted."""
    low = text.lower()
    if not words or len(low) != len(text):
        return [(text, style)]
    marked = [False] * len(text)
    for w in words:
        at = low.find(w)
        while at != -1:
            marked[at:at + len(w)] = [True] * len(w)
            at = low.find(w, at + 1)
    parts, i = [], 0
    while i < len(text):
        j = i
        while j < len(text) and marked[j] == marked[i]:
            j += 1
        parts.append((text[i:j], hit if marked[i] else style))
        i = j
    return parts


def draw(lines):
    """Write (width, text) lines centered in the terminal over the last frame."""
    cols, rows = shutil.get_terminal_size()
    out = [""] * max(0, (rows - len(lines)) // 2)
    out += [" " * max(0, (cols - w) // 2) + t for w, t in lines]
    sys.stdout.write(HOME + "\n".join(l + EOL for l in out) + EOS
                     + ("" if TTY else "\n"))
    sys.stdout.flush()


class Loading:
    """Animated loading screen while sessions are read. It only appears if
    loading takes long enough to notice, so a fast (cached) start has no flash."""

    def __init__(self, progress, label="indexing session logs", unit=""):
        self.progress, self.label, self.unit = progress, label, unit
        self.done = threading.Event()
        self.thread = threading.Thread(target=self.run, daemon=True)

    def __enter__(self):
        if TTY:
            self.thread.start()
        return self

    def __exit__(self, *exc):
        self.done.set()
        if self.thread.is_alive():
            self.thread.join()

    def run(self):
        if self.done.wait(0.12):
            return
        frame = 0
        while not self.done.is_set():
            n, total = self.progress["done"], self.progress["total"] or 1
            filled = 30 * n // total
            amount = (f"{n >> 20}/{total >> 20} MB" if self.unit == "MB"
                      else f"{n}/{total}")
            bar = f"[{'█' * filled}{'░' * (30 - filled)}]  {amount}"
            status = f"{SPINNER[frame % len(SPINNER)]} {self.label}"
            draw([(cells(BANNER), f"{BRIGHT}{BANNER}{RESET}"), (0, ""),
                  (cells(bar), f"{GREEN}{status:<{cells(bar)}}{RESET}"),
                  (cells(bar), f"{DARK}{bar}{RESET}")])
            frame += 1
            self.done.wait(0.08)


# Columns as (key, header, width, style, highlight matches, keep end when cut).
# Width -1 sizes the column to its values; 0 takes whatever room is left.
SESSION_COLUMNS = [("when", "WHEN", 16, GRAY, False, False),
                   ("project", "PROJECT", -1, GREEN, True, False),
                   ("title", "SESSION", 0, PALE, True, False)]
FOLDER_COLUMNS = [("label", "FOLDER", 0, PALE, True, False),
                  ("chats", "CHATS", 5, GRAY, False, False),
                  ("when", "LAST ACTIVE", 16, GRAY, False, False)]


def row_values(r):
    if r.get("kind") == "newsession":
        return {"when": r["title"], "project": "", "title": ""}
    if r.get("kind") == "incoming":  # a chat file from another Mac
        return {"when": "⇣ import", "project": project(r), "title": r["title"]}
    if "label" in r:  # a row of the folder browser
        return {"label": r["label"],
                "chats": f"{r['count']:>5}" if r.get("count") else "",
                "when": when(r["mtime"]) if r.get("mtime") else ""}
    return {"when": when(r["mtime"]), "project": project(r), "title": r["title"]}


def size_columns(spec, drop, items, inner):
    """Give each column its width so a row exactly fills the panel, dropping
    the columns in `drop` (in order) when the terminal is narrow."""
    cols = [list(c) for c in spec]
    for c in cols:
        if c[2] == -1:
            c[2] = min(22, max([cells(c[1])] + [cells(row_values(r)[c[0]]) for r in items]))

    def rest():
        return inner - 5 - 2 * (len(cols) - 1) - sum(c[2] for c in cols if c[2] > 0)
    for key in drop:
        if rest() >= 16:
            break
        cols = [c for c in cols if c[0] != key]
    for c in cols:
        if c[2] == 0:
            c[2] = rest()
    return cols


def show_page(*, view, items, spec, drop, page, pages, cursor, per_page, query,
              count, placeholder, empty, details, hints, note, tab2="[ NEW SESSION ]"):
    """Draw one page as a panel centered in the terminal."""
    cols, _ = shutil.get_terminal_size()
    inner = max(56, min(MAX_WIDTH, cols - 4))  # columns inside the border
    words = query.lower().split()
    columns = size_columns(spec, drop, items, inner)

    def line(*parts):
        """A line inside the border from (text, style) parts, padded to fit."""
        used = sum(cells(t) for t, _ in parts)
        body = "".join(f"{s}{t}{RESET}" for t, s in parts)
        return f"{DARK}│{RESET}{body}{' ' * max(0, inner - used)}{DARK}│{RESET}"

    # Top border: the two tabs on the left, the page on the right.
    tab1 = "[ SESSIONS ]"
    style1, style2 = (SELECTED, GRAY) if view == "sessions" else (GRAY, SELECTED)
    tag = f"[ page {page + 1}/{pages} ]"
    fill = inner - 3 - cells(tab1) - cells(tab2) - cells(tag)  # tab2: second tab's label
    out = [f"{DARK}┌─{RESET}{style1}{tab1}{RESET}{DARK}─{RESET}{style2}{tab2}{RESET}"
           f"{DARK}{'─' * fill}{GREEN}{tag}{DARK}─┐{RESET}", line()]
    pad = (inner - cells(BANNER)) // 2
    out += [line((" " * pad, ""), (BANNER, BRIGHT)), line()]

    # Search box, with the count on the right.
    shown_query = query if cells(query) <= inner - 30 else fit(query, inner - 30, True)
    box = [("  ❯ ", GREEN), (shown_query, BRIGHT), ("█", BRIGHT)]
    if not query:
        box.append((placeholder, GRAY))
    gap = inner - sum(cells(t) for t, _ in box) - cells(count) - 2
    out += [line(*box, (" " * max(1, gap), ""), (count + "  ", GRAY)), line()]

    out.append(line(("    ", ""), *[p for k, c in enumerate(columns) for p in
                                    ([("  ", "")] if k else []) + [(fit(c[1], c[2]), GREEN)]]))
    out.append(line(("    ", ""), *[p for k, c in enumerate(columns) for p in
                                    ([("  ", "")] if k else []) + [("─" * c[2], DARK)]]))
    for i, r in enumerate(items):
        sel = i == cursor
        base = SELECTED if sel else ""
        hit = HIT_SELECTED if sel else HIT
        values = row_values(r)
        parts = [("  ", ""), ("▶ " if sel else "  ", base)]
        for k, (key, _, width, style, highlight, keep_end) in enumerate(columns):
            if k:
                parts.append(("  ", base))
            text = fit(values[key], width, keep_end)
            st = base or r.get("style") or style
            parts += paint(text, st, hit, words) if highlight else [(text, st)]
        out.append(line(*parts, (" ", base)))
    if not items:
        out.append(line(("    ", ""), (fit(empty, inner - 6), WARN)))
    out += [line()] * (per_page - max(len(items), 1) + 1)  # same height every page

    out.append(f"{DARK}├{'─' * inner}┤{RESET}")
    for label, value in details:
        out.append(line((f"  {label:<4} ", GRAY), (fit(value, inner - 9, keep_end=True), GREEN))
                   if label else line())
    out.append(line(("  ! ", WARN), (fit(note, inner - 5), WARN))
               if note else line())
    for drop_hint in ("←→ page", "↑↓ select", "^S export", "tab sessions", "tab new session"):
        if cells("─".join(f"[{h}]" for h in hints)) <= inner - 2:
            break  # fewer hints on a narrow terminal
        hints = [h for h in hints if h != drop_hint]
    keys = "─".join(f"[{h}]" for h in hints)
    out.append(f"{DARK}└─{GREEN}{keys}{DARK}{'─' * (inner - cells(keys) - 1)}┘{RESET}")
    draw([(inner + 2, l) for l in out])


resized = False


def on_resize(*_):
    global resized
    resized = True


def read_key(fd):
    """Read one key press: a character, or "up"/"down"/"left"/"right"/"esc"."""
    ch = os.read(fd, 1)
    if ch == b"\x1b":
        # An arrow key arrives as ESC [ A (or ESC O A); a lone ESC has nothing after it.
        def ready():
            return select.select([fd], [], [], 0.05)[0]
        if not ready():
            return "esc"
        if os.read(fd, 1) not in (b"[", b"O"):
            return ""
        seq = b""
        while ready():
            b = os.read(fd, 1)
            seq += b
            if 0x40 <= b[0] <= 0x7E:  # final byte of the sequence
                break
        return {b"A": "up", b"B": "down", b"C": "right", b"D": "left"}.get(seq, "")
    # Read the rest of a multi-byte UTF-8 character (Thai letters are 3 bytes).
    lead = ch[0]
    extra = 1 if 0xC0 <= lead < 0xE0 else 2 if 0xE0 <= lead < 0xF0 else 3 if 0xF0 <= lead < 0xF8 else 0
    for _ in range(extra):
        ch += os.read(fd, 1)
    return ch.decode(errors="ignore")


def key_action():
    """Wait for a key that means something and return its action, or
    "redraw" when the window is resized so the panel can re-center."""
    global resized
    fd = sys.stdin.fileno()
    while True:
        if not select.select([fd], [], [], 0.2)[0]:
            if resized:
                resized = False
                return "redraw"
            continue
        k = read_key(fd)
        if k in ("up", "down", "esc"):
            return k
        if k == "right":
            return "next"
        if k == "left":
            return "prev"
        if k in ("\r", "\n"):
            return "enter"
        if k == "\t":
            return "tab"
        if k in ("\x7f", "\b"):
            return "backspace"
        if k == "\x15":  # Ctrl-U
            return "clear"
        if k == "\x13":  # Ctrl-S
            return "export"
        if k in ("\x03", "\x04"):  # Ctrl-C, Ctrl-D
            return "quit"
        if k and k.isprintable():
            return ("text", k)


def keys_waiting():
    return bool(select.select([sys.stdin.fileno()], [], [], 0)[0])


def line_action():
    """Whole-line input, for when stdin is not a terminal (e.g. piped): a line
    names a key (up, down, left, right, tab, esc, bs, export, or empty for Enter);
    anything else is typed into the search box."""
    line = input()
    names = {"up": "up", "down": "down", "right": "next", "left": "prev",
             "tab": "tab", "esc": "esc", "bs": "backspace", "export": "export",
             "": "enter"}
    return names.get(line, ("text", line))


def human(size):
    return f"{size / 1048576:.0f} MB" if size >= 1048576 else f"{max(1, size >> 10)} KB"


def pick(rows, recent, per_page, query, view, next_action, waiting,
         incoming=(), importing=None):
    """Search and page through chats, or browse folders for a new session
    (Tab switches). `importing` is a chat file from another Mac whose project
    folder is being picked. Returns ("resume", chat), ("new", folder row), or None."""
    start = os.getcwd()
    location = None  # folder browser: None is its start page
    page, cursor, note, focus = 0, 0, "", None

    def unpack(m, target):
        progress = {"done": 0, "total": 0}
        with Loading(progress, "unpacking chat", unit="MB"):
            return import_bundle(m, target, progress)

    def choose_folder_for(m):
        nonlocal importing, view, note
        importing, view = m, "new"
        note = f"Where is {project(m)} on this Mac? Pick its folder (it was {tilde(m['cwd'])})."

    if importing:  # `cs import FILE`
        target = import_target(importing)
        if target:
            try:
                return ("resume", unpack(importing, target))
            except (OSError, EOFError, tarfile.TarError, ValueError) as e:
                note, importing = f"Couldn't import it: {e}", None
        else:
            choose_folder_for(importing)
    while True:
        words = query.lower().split()
        if view == "sessions":
            found = ([r for r in rows if all(w in haystack(r) for w in words)]
                     if words else list(incoming) + [NEW_ROW] + rows)
            count = f"{len(found)} of {len(rows)} sessions" if words else f"{len(rows)} sessions"
        else:
            found = explorer_items(location, query, recent, start)
            folders = sum(1 for r in found if r["kind"] == "dir")
            count = f"{folders} recent folders" if location is None else f"{folders} folders"
        if focus:  # after going up, land on the folder we came from
            at = next((i for i, r in enumerate(found) if r["cwd"] == focus
                       and r.get("kind") == "dir"), 0)
            page, cursor, focus = at // per_page, at % per_page, None
        pages = max(1, math.ceil(len(found) / per_page))
        page = min(page, pages - 1)
        page_rows = found[page * per_page:(page + 1) * per_page]
        cursor = max(0, min(cursor, len(page_rows) - 1))
        sel = page_rows[cursor] if page_rows else None
        kind_ = sel.get("kind") if sel else None

        if view == "sessions":
            spec, drop = SESSION_COLUMNS, ["project"]
            if sel is NEW_ROW:
                details = [("new", "pick a folder on the next screen"), ("", "")]
            elif kind_ == "incoming":
                details = [("file", tilde(sel["bundle"]["file"])), ("from", sel["cwd"])]
            else:
                details = [("dir", sel["cwd"]), ("id", sel["id"])] if sel else [("", ""), ("", "")]
            enter = {"newsession": "⏎ new session", "incoming": "⏎ import"}.get(kind_, "⏎ resume")
            hints = ["↑↓ select", enter] + ([] if kind_ else ["^S export"])
            hints += ["tab new session"] + (["←→ page"] if pages > 1 else [])
            hints.append("esc clear" if query else "esc quit")
            placeholder = " type to search projects and titles"
        else:
            spec, drop = FOLDER_COLUMNS, ["chats", "when"]
            details = [("dir", sel["cwd"] if sel else ""),
                       ("in", tilde(location) if location else "recent folders")]
            hints = ["↑↓ select", {"up": "⏎ go up", "mkdir": "⏎ create folder"}.get(
                kind_, "⏎ import here" if importing else "⏎ start session"), "→ open"]
            if location is not None:
                hints.append("← back")
            hints += ["tab sessions", "esc clear" if query else "esc back"]
            placeholder = (" type to filter recent folders" if location is None
                           else " type to filter, or a name for a new folder")
        if not waiting():  # skip frames while typed/pasted keys are queued
            show_page(view=view, items=page_rows, spec=spec, drop=drop, page=page,
                      pages=pages, cursor=cursor, per_page=per_page, query=query,
                      count=count, placeholder=placeholder,
                      empty=f'no sessions match "{query}"', details=details,
                      hints=hints, note=note,
                      tab2="[ IMPORT TO… ]" if importing else "[ NEW SESSION ]")
            note = ""
        try:
            action = next_action()
        except (EOFError, KeyboardInterrupt):
            return None
        kind, text = action if isinstance(action, tuple) else (action, "")

        def go(folder, came_from=None):
            nonlocal location, query, page, cursor, focus
            location, query, page, cursor, focus = folder, "", 0, 0, came_from

        if kind == "quit":
            return None
        if kind == "esc":
            if query:
                query, page, cursor = "", 0, 0
            elif view == "new":
                view, page, cursor, importing = "sessions", 0, 0, None
            else:
                return None
        elif kind == "tab":
            view = "new" if view == "sessions" else "sessions"
            query, page, cursor, importing = "", 0, 0, None
        elif kind == "export":
            if view != "sessions" or not sel or kind_:
                note = "Select a chat, then press Ctrl-S to save it for another Mac."
            else:
                progress = {"done": 0, "total": 0}
                try:
                    with Loading(progress, "packing chat for another Mac", unit="MB"):
                        dest = export_session(sel, progress)
                    note = (f"Saved {os.path.basename(dest)} ({human(os.path.getsize(dest))}) "
                            "to Downloads. AirDrop it to your other Mac.")
                    if TTY:
                        subprocess.run(["open", "-R", dest], check=False)  # show in Finder
                except OSError as e:
                    note = f"Couldn't save it: {e.strerror or e}"
        elif kind == "enter" and sel:
            if kind_ == "newsession":
                view = "new"
                go(None)
            elif kind_ == "incoming":
                target = import_target(sel["bundle"])
                if not target:
                    choose_folder_for(sel["bundle"])
                    go(None)
                else:
                    try:
                        return ("resume", unpack(sel["bundle"], target))
                    except (OSError, EOFError, tarfile.TarError, ValueError) as e:
                        note = f"Couldn't import it: {e}"
            elif view == "sessions":
                return ("resume", sel)
            elif kind_ == "up":
                go(sel["cwd"], came_from=location)
            elif kind_ == "mkdir":
                if not query.strip():
                    note = "Type the new folder's name, then press Enter on this row."
                else:
                    try:
                        existed = os.path.isdir(sel["cwd"])
                        os.makedirs(sel["cwd"], exist_ok=True)
                        go(sel["cwd"])
                        if not existed:
                            note = f"Created {os.path.basename(location.rstrip('/'))}/"
                    except OSError as e:
                        note = f"Couldn't create it: {e.strerror}"
            elif kind_ in ("here", "dir") and importing:
                try:
                    return ("resume", unpack(importing, sel["cwd"]))
                except (OSError, EOFError, tarfile.TarError, ValueError) as e:
                    note = f"Couldn't import it: {e}"
            elif kind_ in ("here", "dir"):
                return ("new", sel)
        elif kind == "next":
            if view == "new":
                # Open a folder (on the start page, the current folder too).
                if kind_ in ("dir", "up") or (kind_ == "here" and location is None):
                    go(sel["cwd"], came_from=location if kind_ == "up" else None)
            elif page < pages - 1:
                page, cursor = page + 1, 0
            else:
                note = "This is the last page."
        elif kind == "prev":
            if view == "new":
                if location is None:
                    note = "These are your recent folders. → opens one."
                elif location == "/":
                    go(None)
                else:
                    go(os.path.dirname(location.rstrip("/")) or "/", came_from=location)
            elif page:
                page, cursor = page - 1, 0
            else:
                note = "This is the first page."
        elif kind == "text":
            query, page, cursor = query + text, 0, 0
        elif kind == "backspace":
            query, page, cursor = query[:-1], 0, 0
        elif kind == "clear":
            query, page, cursor = "", 0, 0
        elif kind == "down":
            if cursor < len(page_rows) - 1:
                cursor += 1
            elif page < pages - 1:
                page, cursor = page + 1, 0
        elif kind == "up":
            if cursor:
                cursor -= 1
            elif page:
                page, cursor = page - 1, per_page - 1


def launch_banner(r, new=False):
    """Printed while claude starts, since a big session takes a while to load."""
    width = max(20, min(shutil.get_terminal_size().columns, MAX_WIDTH) - 8)
    if new:
        return "\n".join([
            "",
            f"  {BRIGHT}▓▒░ NEW SESSION ░▒▓{RESET}",
            "",
            f"  {SELECTED}▶ {fit(project(r), width).rstrip()} {RESET}",
            f"    {GRAY}{r['cwd']}{RESET}",
            "", ""])
    mb = r["size"] / 1048576
    size = f"{mb:.0f} MB" if mb >= 1 else f"{max(1, r['size'] // 1024)} KB"
    wait = " (big session, this can take a few seconds)" if mb >= 50 else ""
    return "\n".join([
        "",
        f"  {BRIGHT}▓▒░ RESUMING SESSION ░▒▓{RESET}",
        "",
        f"  {SELECTED}▶ {fit(r['title'], width).rstrip()} {RESET}",
        f"    {GREEN}{project(r)}{RESET}  {GRAY}{r['cwd']}{RESET}",
        f"    {GRAY}⣿ loading {size} of history{wait}…{RESET}",
        "", ""])


# The `cs` shell function printed by `claude-sessions init zsh`. It has to be a
# function, not a command, so the cd happens in your shell and you are still
# in the project after quitting claude.
ZSH_INIT = r'''# cs: pick a Claude Code chat (or a project for a new one) and open it there.
unalias cs 2>/dev/null
function cs {
  local out dir id
  out=$(mktemp -t cs) || return
  CS_OUT=$out command claude-sessions "$@"
  { IFS= read -r dir; IFS= read -r id } < "$out"
  # Nothing picked: no folder and no session.
  [[ -n $dir || -n $id ]] || { rm -f "$out"; return 0 }
  if [[ -n $dir && -d $dir ]]; then
    cd "$dir"
  elif [[ -n $dir ]]; then
    print -u2 "cs: $dir no longer exists; staying in $PWD"
  fi
  # Warp only learns the folder when a command finishes. Use Warp's own
  # hooks to end the `cs` block here (in the new folder) and start a new
  # block for claude, so Warp shows the project folder while claude runs.
  if (( $+functions[warp_precmd] && $+functions[warp_preexec] )); then
    warp_precmd
    warp_preexec "claude${id:+ --resume $id}"
  fi
  tail -n +3 "$out"  # the picker's banner, shown while claude starts
  rm -f "$out"
  # No session id means "start a new session in this folder".
  if [[ -n $id ]]; then claude --resume "$id"; else claude; fi
}
'''

def main():
    if sys.argv[1:] == ["--version"]:
        print(f"claude-sessions {VERSION}")
        return
    # Not when run from `cs` (CS_OUT set), where "init zsh" is just a search.
    if sys.argv[1:] == ["init", "zsh"] and not os.environ.get("CS_OUT"):
        sys.stdout.write(ZSH_INIT)
        return
    args = [a for a in sys.argv[1:] if a not in ("-w", "--web")]
    view = "sessions"
    if "--new" in args:
        view = "new"
        args = [a for a in args if a != "--new"]
    # Fewer per page if the window is too short to show the whole panel.
    per_page = min(PAGE_SIZE, max(5, shutil.get_terminal_size().lines - PANEL_LINES))
    if "-n" in args:
        i = args.index("-n")
        per_page = max(1, int(args[i + 1]))
        del args[i:i + 2]
    importing = None
    if args[:1] == ["import"]:  # cs import FILE: a chat saved on another Mac
        if len(args) != 2:
            print("usage: cs import <file>" + BUNDLE_EXT, file=sys.stderr)
            return
        importing = read_bundle(os.path.abspath(os.path.expanduser(args[1])))
        if not importing:
            print(f"cs: {args[1]} isn't a chat saved with Ctrl-S in cs.", file=sys.stderr)
            return
        args = []
    query = " ".join(args)

    # On a terminal, read single key presses so arrows act immediately.
    keys = sys.stdin.isatty()
    saved = termios.tcgetattr(sys.stdin) if keys else None
    old_winch = signal.signal(signal.SIGWINCH, on_resize) if keys else None
    rows, picked = [], None
    sys.stdout.write(ALT_ON)
    try:
        if keys:
            tty.setcbreak(sys.stdin)  # keys typed while loading go to the search
            attrs = termios.tcgetattr(sys.stdin)
            attrs[0] &= ~termios.IXON  # let Ctrl-S reach us instead of pausing output
            termios.tcsetattr(sys.stdin, termios.TCSANOW, attrs)
        progress = {"done": 0, "total": 0}
        with Loading(progress):
            rows = load_sessions(progress)
        picked = pick(rows, projects_of(rows), per_page, query, view,
                      key_action if keys else line_action,
                      keys_waiting if keys else (lambda: False),
                      incoming=incoming_bundles(), importing=importing)
    except KeyboardInterrupt:
        pass  # quit quietly
    finally:
        if saved:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
            signal.signal(signal.SIGWINCH, old_winch)
        sys.stdout.write(ALT_OFF)
        sys.stdout.flush()
    if picked is None:
        return
    kind, r = picked
    new = kind == "new"
    session = "" if new else r["id"]  # no session id: start a new one
    # Called from the `cs` shell function: hand the pick back so the shell
    # itself cd's into the project (a child process cannot move its parent),
    # plus the banner to show while claude starts.
    out = os.environ.get("CS_OUT")
    if out:
        with open(out, "w") as f:
            f.write(f"{r['cwd']}\n{session}\n{launch_banner(r, new)}")
        return
    if r["cwd"] and os.path.isdir(r["cwd"]):
        os.chdir(r["cwd"])
    sys.stdout.write(launch_banner(r, new))
    sys.stdout.flush()
    os.execvp("claude", ["claude"] + (["--resume", session] if session else []))


if __name__ == "__main__":
    main()
